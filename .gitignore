data/raw/**/*.tsv
data/raw/**/*.txt
data/raw/**/*.xlsx
data/raw/**/*.gz
data/metadata/**/*.csv
data/metadata/**/*.tsv
data/metadata/**/*.txt
data/metadata/**/*.xlsx

# Large DEG input matrices. Small signature-level and figure inputs remain.
data/processed/GSE159699/EDITED_COUNTS.csv
data/processed/GSE203206/GSE203206_Subramaniam.ADRC_brain.counts.tsv
data/processed/GSE278723/output_*.csv
